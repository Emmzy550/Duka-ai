# LLM: amd (default, OpenAI-compatible AMD endpoint) or openai (generic OpenAI-compatible URL)
LLM_PROVIDER=amd

# AMD / MI300X OpenAI-compatible API (used when LLM_PROVIDER=amd)
AMD_BASE_URL=http://165.245.131.144:8000/v1
AMD_API_KEY=duka-ai-key
AMD_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Generic OpenAI-compatible API (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_NAME=llama-3.3-70b-versatile

GMAIL_ADDRESS=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
APP_ENV=development
# Optional: live Zambia/market web search (Market Intelligence agent + Tavily)
TAVILY_API_KEY=
